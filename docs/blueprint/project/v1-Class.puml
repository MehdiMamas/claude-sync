@startuml
skinparam shadowing false
skinparam backgroundColor #ffffff
skinparam defaultFontName sans-serif
skinparam defaultFontSize 13
skinparam defaultFontColor #1c1f24
skinparam ArrowColor #5f6672
skinparam ArrowFontColor #1c1f24
skinparam roundCorner 8
skinparam RectangleBackgroundColor #ffffff
skinparam RectangleBorderColor #5f6672
skinparam RectangleFontColor #1c1f24
skinparam NodeBackgroundColor #ffffff
skinparam NodeBorderColor #5f6672
skinparam ComponentBackgroundColor #ffffff
skinparam ComponentBorderColor #5f6672
skinparam ClassBackgroundColor #ffffff
skinparam ClassBorderColor #5f6672
skinparam ClassAttributeFontColor #1c1f24
skinparam ActorBackgroundColor #ffffff
skinparam ActorBorderColor #5f6672
skinparam UsecaseBackgroundColor #e6eefc
skinparam UsecaseBorderColor #2f6fde
skinparam DatabaseBackgroundColor #ffffff
skinparam DatabaseBorderColor #5f6672
skinparam CloudBackgroundColor #ffffff
skinparam CloudBorderColor #5f6672
skinparam PackageBackgroundColor #f6f7f9
skinparam PackageBorderColor #5f6672
skinparam PackageFontColor #1c1f24
skinparam NoteBackgroundColor #fff4dc
skinparam NoteBorderColor #9a5b00
skinparam NoteFontColor #1c1f24
hide empty members
class Engine {
 +create_group()
 +add_member()
 +accept_invitation()
 +sync_group()
 +resolve_edit()
 +revert_commit()
 +personal_sync()
}
class Session {
 +access token
 +refresh 5 min early
}
class GitHub {
 +GET with ETag cache
 +graphql heads
 +rate limit reset
}
class Remote {
 +head_if_changed()
 +files_matching()
 +push blobs, tree, commit
}
class Paths {
 +state dir
 +conflicts_dir()
}
class GroupStatus {
 +head
 +last_sync_unix
 +rate_limited_until
 +invited
}
class Job {
 +id, cron, prompt
 +consent_hash()
}
class Scheduler
Engine --> Session
Engine --> Remote
Remote --> GitHub
GitHub --> Session
Engine --> Paths
Engine --> GroupStatus
Engine --> Job
Job --> Scheduler
@enduml
