{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "claude-sync",
  "mainBinaryName": "claude-sync",
  "identifier": "com.mehdimamas.claudesync",
  "build": {
    "beforeDevCommand": { "script": "pnpm dev", "cwd": "../ui", "wait": false },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": { "script": "pnpm build", "cwd": "../ui" },
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https://avatars.githubusercontent.com; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app"],
    "createUpdaterArtifacts": true,
    "publisher": "El Mehdi Mamas",
    "copyright": "El Mehdi Mamas",
    "shortDescription": "Sync Claude Code settings with friends",
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": { "installMode": "currentUser", "installerHooks": "./windows/hooks.nsh" }
    },
    "macOS": { "minimumSystemVersion": "11.0" }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU0QjY2QkU1RTM0MTI2NDkKUldSSkprSGo1V3UyVlByU2doaS9VNmM1eWNwdHBhRkFQdkdsZ1hsUXI4Tm50Z3FFYnlXLzNmN0sK",
      "endpoints": [],
      "windows": { "installMode": "passive" }
    }
  }
}
