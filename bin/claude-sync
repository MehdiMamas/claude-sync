#!/usr/bin/env bash
# claude-sync dispatcher. Subcommands for later phases are not registered here.
set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

# shellcheck source=lib/sync.sh
source "$ROOT/lib/sync.sh"
# shellcheck source=lib/link.sh
source "$ROOT/lib/link.sh"
# shellcheck source=lib/init.sh
source "$ROOT/lib/init.sh"

VERSION="0.0.0"

usage() {
  cat <<'EOF'
Usage: claude-sync pull [--hook]
       claude-sync push [--hook]
       claude-sync link
       claude-sync unlink
       claude-sync status
       claude-sync init [--create <name> | --remote <url>] [--dir <path>]
       claude-sync join <url> [--merge | --replace] [--dir <path>]
       claude-sync --version
       claude-sync --help
EOF
}

: "${CLAUDE_SYNC_DIR:=$HOME/.claude-sync}"
: "${CLAUDE_HOME:=$HOME/.claude}"
: "${CLAUDE_SYNC_TIMEOUT:=20}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/claude-sync"

# CLAUDE_HOME is the Claude config dir. link, unlink and status use it.
# shellcheck disable=SC2034
export CLAUDE_SYNC_DIR CLAUDE_HOME CLAUDE_SYNC_TIMEOUT STATE_DIR

export HOOK=0
CMD=""

# --hook anywhere in the arguments means a bad invocation still exits 0.
for _arg in "$@"; do
  if [ "$_arg" = "--hook" ]; then
    HOOK=1
  fi
done

bad_args() {
  if [ "$HOOK" -eq 1 ]; then
    printf 'claude-sync: unknown argument.\n' >&2
    exit 0
  fi
  usage >&2
  exit 1
}

while [ $# -gt 0 ]; do
  case "$1" in
    --hook)
      HOOK=1
      ;;
    --version)
      if [ -n "$CMD" ]; then
        bad_args
      fi
      CMD=version
      ;;
    --help|-h)
      if [ -n "$CMD" ]; then
        bad_args
      fi
      CMD=help
      ;;
    pull|push|link|unlink|status)
      if [ -n "$CMD" ]; then
        bad_args
      fi
      CMD=$1
      ;;
    init|join)
      if [ -n "$CMD" ]; then
        bad_args
      fi
      CMD=$1
      shift
      break
      ;;
    *)
      bad_args
      ;;
  esac
  shift
done
export HOOK

case "$CMD" in
  link|unlink|status|init|join)
    if [ "$HOOK" -eq 1 ]; then
      bad_args
    fi
    ;;
esac

case "$CMD" in
  version)
    printf 'claude-sync %s\n' "$VERSION"
    ;;
  help)
    usage
    ;;
  pull)
    sync_pull
    ;;
  push)
    sync_push
    ;;
  link)
    cmd_link
    ;;
  unlink)
    cmd_unlink
    ;;
  status)
    cmd_status
    ;;
  init)
    cmd_init "$@"
    ;;
  join)
    cmd_join "$@"
    ;;
  *)
    if [ "$HOOK" -eq 1 ]; then
      printf 'claude-sync: missing command.\n' >&2
      exit 0
    fi
    usage >&2
    exit 1
    ;;
esac
